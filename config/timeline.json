      "speaker": "narrator",
      "start": 0.15,
      "end": 4.30,
      "text": "Pull a metal spring twice as far—and it pulls back twice as hard."
    },
    {
      "id": "L2",
      "beatId": "B2",
      "speaker": "skeptic",
      "start": 4.55,
      "end": 6.95,
      "text": "A scrambled riddle? Prove your hidden law!"
    },
    {
      "id": "L3",
      "beatId": "B2",
      "speaker": "hooke",
      "start": 7.10,
      "end": 9.38,
      "text": "As the stretch, so the force—F equals minus k x!"
    },
    {
      "id": "L4",
      "beatId": "B3",
      "speaker": "narrator",
      "start": 9.60,
      "end": 15.30,
      "text": "With his brass microscope, Robert Hooke peered into cork—and named its honeycomb rooms 'cells'!"
    },
    {
      "id": "L5",
      "beatId": "B4",
      "speaker": "narrator",
      "start": 15.60,
      "end": 18.45,
      "text": "Push a spring past its elastic limit—and it snaps forever."
    },
    {
      "id": "L6",
      "beatId": "B4",
      "speaker": "skeptic",
      "start": 18.60,
      "end": 20.30,
      "text": "Hey—that ruined my watch!"
    },
    {
      "id": "L7",
      "beatId": "B5",
      "speaker": "narrator",
      "start": 20.60,
      "end": 25.25,
      "text": "Tame that tiny hairspring inside a balance wheel—and humanity mastered portable time."
    },
    {
      "id": "L8",
      "beatId": "B6",
      "speaker": "narrator",
      "start": 25.60,
      "end": 29.60,
      "text": "Car suspensions, skyscrapers, even DNA strands today? Still obeying Hooke's law."
    }
