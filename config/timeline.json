  "dialogue": [
    {
      "id": "L1",
      "beatId": "B1",
      "speaker": "narrator",
      "start": 0.15,
      "end": 4.35,
      "text": "Hang one weight on a spring, it stretches. Double the weight—it stretches twice as far!"
    },
    {
      "id": "L2",
      "beatId": "B2",
      "speaker": "skeptic",
      "start": 4.55,
      "end": 6.95,
      "text": "Scrambled Latin letters, Hooke? Explain your hidden law!"
    },
    {
      "id": "L3",
      "beatId": "B2",
      "speaker": "hooke",
      "start": 7.10,
      "end": 9.38,
      "text": "More stretch means more pullback—F equals minus k x!"
    },
    {
      "id": "L4",
      "beatId": "B3",
      "speaker": "narrator",
      "start": 9.60,
      "end": 15.30,
      "text": "Next, Hooke aimed his brass microscope at cork—and named those tiny honeycomb rooms 'cells'!"
    },
    {
      "id": "L5",
      "beatId": "B4",
      "speaker": "narrator",
      "start": 15.60,
      "end": 18.40,
      "text": "Warning: stretch past the elastic limit, and metal deforms forever."
    },
    {
      "id": "L6",
      "beatId": "B4",
      "speaker": "skeptic",
      "start": 18.55,
      "end": 20.30,
      "text": "No! You snapped my watch spring!"
    },
    {
      "id": "L7",
      "beatId": "B5",
      "speaker": "narrator",
      "start": 20.60,
      "end": 25.25,
      "text": "Yet Hooke's tiny spiral hairspring tamed the pocket watch—shrinking clocks to fit your palm!"
    },
    {
      "id": "L8",
      "beatId": "B6",
      "speaker": "narrator",
      "start": 25.60,
      "end": 29.60,
      "text": "Car shocks, skyscrapers, even DNA coils today—all obey Robert Hooke's law."
    }
  ],
